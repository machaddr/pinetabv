From 7c0729895a9ea88269786fd3641ea2bcdf7e7af6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Machado?= <machaddr@falanet.org>
Date: Mon, 24 Aug 2026 19:20:00 +0100
Subject: [PATCH] drm/bridge: cdns-dsi: skip internal D-PHY setup on JH7110
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

JH7110 connects the Cadence DSI host to an external M31 D-PHY.  The
common host code nevertheless programs MCTL_DPHY_CFG0 as if the Cadence
internal PHY were present, then waits for that internal PLL.

StarFive removed these accesses when it added the four-lane Jadard panel
path, and the PineTab-V U-Boot display sequence does not access this
register either.  Retaining them can disturb the external integration.

Add a platform flag and set it only on JH7110.  Continue using the PHY
framework to initialize, configure and power the M31 PHY, while skipping
only the Cadence internal-PHY power, PLL and reset sequence.  Other
Cadence integrations retain the existing behavior.

Assisted-by: Codex:gpt-5
Signed-off-by: André Machado <machaddr@falanet.org>
---
 drivers/gpu/drm/bridge/cadence/cdns-dsi-core.c   | 14 +++++++++++---
 drivers/gpu/drm/bridge/cadence/cdns-dsi-core.h   |  2 ++
 drivers/gpu/drm/bridge/cadence/cdns-dsi-jh7110.c |  1 +
 3 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/bridge/cadence/cdns-dsi-core.c b/drivers/gpu/drm/bridge/cadence/cdns-dsi-core.c
index bec79095d..21cfbed71 100644
--- a/drivers/gpu/drm/bridge/cadence/cdns-dsi-core.c
+++ b/drivers/gpu/drm/bridge/cadence/cdns-dsi-core.c
@@ -667,6 +667,8 @@ static void cdns_dsi_bridge_atomic_post_disable(struct drm_bridge *bridge,
 int cdns_dsi_hs_init(struct cdns_dsi *dsi)
 {
 	struct cdns_dsi_output *output = &dsi->output;
+	bool external_dphy = dsi->platform_ops &&
+			     dsi->platform_ops->external_dphy;
 	u32 status;
 	int ret;
 
@@ -676,9 +678,10 @@ int cdns_dsi_hs_init(struct cdns_dsi *dsi)
 	 * Power all internal DPHY blocks down and maintain their reset line
 	 * asserted before changing the DPHY config.
 	 */
-	writel(DPHY_CMN_PSO | DPHY_PLL_PSO | DPHY_ALL_D_PDN | DPHY_C_PDN |
-	       DPHY_CMN_PDN | DPHY_PLL_PDN,
-	       dsi->regs + MCTL_DPHY_CFG0);
+	if (!external_dphy)
+		writel(DPHY_CMN_PSO | DPHY_PLL_PSO | DPHY_ALL_D_PDN |
+		       DPHY_C_PDN | DPHY_CMN_PDN | DPHY_PLL_PDN,
+		       dsi->regs + MCTL_DPHY_CFG0);
 
 	ret = phy_init(dsi->dphy);
 	if (ret)
@@ -696,6 +699,11 @@ int cdns_dsi_hs_init(struct cdns_dsi *dsi)
 	if (ret)
 		goto exit_phy;
 
+	if (external_dphy) {
+		dsi->phy_initialized = true;
+		return 0;
+	}
+
 	/* Activate the PLL and wait until it's locked. */
 	writel(PLL_LOCKED, dsi->regs + MCTL_MAIN_STS_CLR);
 	writel(DPHY_CMN_PSO | DPHY_ALL_D_PDN | DPHY_C_PDN | DPHY_CMN_PDN,
diff --git a/drivers/gpu/drm/bridge/cadence/cdns-dsi-core.h b/drivers/gpu/drm/bridge/cadence/cdns-dsi-core.h
index 02b7723b1..af6dab354 100644
--- a/drivers/gpu/drm/bridge/cadence/cdns-dsi-core.h
+++ b/drivers/gpu/drm/bridge/cadence/cdns-dsi-core.h
@@ -65,6 +65,7 @@ struct cdns_dsi;
  * @link_config: Adjust link control registers before starting the link
  * @video_start: Adjust the main enable register before starting video
  * @link_started: Called after starting a previously disabled DSI link
+ * @external_dphy: D-PHY is managed outside the Cadence controller
  */
 struct cdns_dsi_platform_ops {
 	int (*init)(struct cdns_dsi *dsi);
@@ -80,6 +81,7 @@ struct cdns_dsi_platform_ops {
 	void (*link_config)(struct cdns_dsi *dsi, u32 *phy_ctl, u32 *main_en);
 	void (*video_start)(struct cdns_dsi *dsi, u32 *main_en);
 	void (*link_started)(struct cdns_dsi *dsi);
+	bool external_dphy;
 };
 
 struct cdns_dsi {
diff --git a/drivers/gpu/drm/bridge/cadence/cdns-dsi-jh7110.c b/drivers/gpu/drm/bridge/cadence/cdns-dsi-jh7110.c
index 539f8799f..8545f5ba2 100644
--- a/drivers/gpu/drm/bridge/cadence/cdns-dsi-jh7110.c
+++ b/drivers/gpu/drm/bridge/cadence/cdns-dsi-jh7110.c
@@ -228,4 +228,5 @@ const struct cdns_dsi_platform_ops dsi_jh7110_ops = {
 	.link_config = cdns_dsi_jh7110_link_config,
 	.video_start = cdns_dsi_jh7110_video_start,
 	.link_started = cdns_dsi_jh7110_link_started,
+	.external_dphy = true,
 };
