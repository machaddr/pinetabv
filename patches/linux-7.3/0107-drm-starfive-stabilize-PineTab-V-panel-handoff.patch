From 9c7b5f9471ac3db8fc02517723d204fdac745d72 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Machado?= <machaddr@falanet.org>
Date: Thu, 27 Aug 2026 18:30:00 +0100
Subject: [PATCH] drm: starfive: stabilize PineTab-V panel handoff
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

PineTab-V firmware initializes the Jadard LCD controller before Linux.
Linux then requests the panel-enable GPIO low at probe and raises it again
during the first atomic commit.  On PineTab-V that GPIO controls the
VCC_LCD load switch, not just a logic-level enable.  The interval between
probe and prepare is scheduler dependent and can be too short to discharge
the rail.  The controller can consequently retain a partial firmware state
and ignore part of the Linux initialization table.

Give the PineTab-V panel descriptor a 120 ms initial power-off interval.
Also power-cycle VCC_LCD between initialization retries instead of only
pulsing reset, and leave the panel safely powered down after a failed DSI
transaction so a later atomic commit can retry from a known state.

The JH7110 D-PHY currently gives its PLL one 5 ms lock window.  The
StarFive vendor implementation waits without a timeout, which indicates
that lock can take longer after firmware has already used the block.  Do
not inherit the unbounded wait, but allow three 20 ms attempts with a reset
pulse between them.  Never release the DSI link unless PLL lock succeeded.

Together these changes make the U-Boot-to-Linux display takeover
deterministic while keeping all waits and retries bounded.

Assisted-by: Codex:gpt-5
Signed-off-by: André Machado <machaddr@falanet.org>
---
 .../panel/panel-boe-th101mb31ig002-28a.c     | 94 +++++++++++++++----
 drivers/phy/starfive/phy-jh7110-dphy-tx.c    | 28 ++++--
 2 files changed, 97 insertions(+), 25 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c b/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c
index 094cca8c8afa..fc181d50fd50 100644
--- a/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c
+++ b/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c
@@ -37,6 +37,7 @@ struct panel_desc {
 	unsigned int backlight_off_to_display_off_delay_ms;
 	unsigned int enter_sleep_to_reset_down_delay_ms;
 	unsigned int power_off_delay_ms;
+	unsigned int initial_power_off_delay_ms;
 	unsigned int init_retries;
 	bool keep_powered_without_reset;
 	bool prepare_prev_first;
@@ -91,6 +92,41 @@ static void boe_th101mb31ig002_reset(struct boe_th101mb31ig002 *ctx)
 	usleep_range(5000, 6000);
 }
 
+static int boe_th101mb31ig002_enable_panel_power(struct boe_th101mb31ig002 *ctx)
+{
+	int ret;
+
+	gpiod_set_value_cansleep(ctx->enable, 1);
+	if (ctx->desc->enable_to_reset_delay_ms)
+		msleep(ctx->desc->enable_to_reset_delay_ms);
+	else
+		msleep(50);
+
+	if (!ctx->desc->lp11_after_enable)
+		return 0;
+
+	ret = mipi_dsi_dcs_nop(ctx->dsi);
+	if (ret < 0)
+		return ret;
+
+	if (ctx->desc->lp11_to_reset_delay_ms)
+		msleep(ctx->desc->lp11_to_reset_delay_ms);
+
+	return 0;
+}
+
+static void boe_th101mb31ig002_power_down(struct boe_th101mb31ig002 *ctx)
+{
+	if (ctx->reset)
+		gpiod_set_value_cansleep(ctx->reset, 1);
+	gpiod_set_value_cansleep(ctx->enable, 0);
+
+	if (ctx->powered) {
+		regulator_disable(ctx->power);
+		ctx->powered = false;
+	}
+}
+
 static int boe_th101mb31ig002_enable(struct boe_th101mb31ig002 *ctx)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
@@ -262,11 +298,23 @@ static int boe_th101mb31ig002_prepare(struct drm_panel *panel)
 						      struct boe_th101mb31ig002,
 						      panel);
 	struct device *dev = &ctx->dsi->dev;
-	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 	unsigned int attempt;
 	int ret;
 
 	if (!ctx->powered) {
+		/*
+		 * Firmware can leave the panel enabled.  Boards that switch the
+		 * panel rail through the enable GPIO need a real discharge interval
+		 * before the first Linux initialization, otherwise the controller
+		 * can retain a partially initialized state across the handoff.
+		 */
+		if (ctx->desc->initial_power_off_delay_ms) {
+			if (ctx->reset)
+				gpiod_set_value_cansleep(ctx->reset, 1);
+			gpiod_set_value_cansleep(ctx->enable, 0);
+			msleep(ctx->desc->initial_power_off_delay_ms);
+		}
+
 		ret = regulator_enable(ctx->power);
 		if (ret) {
 			dev_err(dev, "Failed to enable power supply: %d\n", ret);
@@ -280,28 +328,17 @@ static int boe_th101mb31ig002_prepare(struct drm_panel *panel)
 		msleep(ctx->desc->vcioo_to_lp11_delay_ms);
 
 	if (ctx->desc->lp11_before_reset) {
-		mipi_dsi_dcs_nop_multi(&dsi_ctx);
-		if (dsi_ctx.accum_err)
-			return dsi_ctx.accum_err;
+		ret = mipi_dsi_dcs_nop(ctx->dsi);
+		if (ret < 0)
+			goto power_down;
 
 		if (ctx->desc->lp11_to_reset_delay_ms)
 			msleep(ctx->desc->lp11_to_reset_delay_ms);
 	}
 
-	gpiod_set_value_cansleep(ctx->enable, 1);
-	if (ctx->desc->enable_to_reset_delay_ms)
-		msleep(ctx->desc->enable_to_reset_delay_ms);
-	else
-		msleep(50);
-
-	if (ctx->desc->lp11_after_enable) {
-		mipi_dsi_dcs_nop_multi(&dsi_ctx);
-		if (dsi_ctx.accum_err)
-			return dsi_ctx.accum_err;
-
-		if (ctx->desc->lp11_to_reset_delay_ms)
-			msleep(ctx->desc->lp11_to_reset_delay_ms);
-	}
+	ret = boe_th101mb31ig002_enable_panel_power(ctx);
+	if (ret)
+		goto power_down;
 
 	for (attempt = 0; attempt <= ctx->desc->init_retries; attempt++) {
 		boe_th101mb31ig002_reset(ctx);
@@ -316,10 +353,28 @@ static int boe_th101mb31ig002_prepare(struct drm_panel *panel)
 		dev_warn(dev,
 			 "panel initialization attempt %u failed: %d, retrying\n",
 			 attempt + 1, ret);
-		msleep(20);
+
+		if (ctx->desc->initial_power_off_delay_ms) {
+			if (ctx->reset)
+				gpiod_set_value_cansleep(ctx->reset, 1);
+			gpiod_set_value_cansleep(ctx->enable, 0);
+			msleep(ctx->desc->initial_power_off_delay_ms);
+
+			ret = boe_th101mb31ig002_enable_panel_power(ctx);
+			if (ret) {
+				dev_warn(dev,
+					 "panel power-cycle failed: %d\n", ret);
+				break;
+			}
+		} else {
+			msleep(20);
+		}
 	}
 
 	dev_err(dev, "panel initialization failed: %d\n", ret);
+
+power_down:
+	boe_th101mb31ig002_power_down(ctx);
 	return ret;
 }
 
@@ -379,6 +434,7 @@ static const struct panel_desc pinetab_v_desc = {
 	.enable_to_reset_delay_ms = 250,
 	.lp11_after_enable = true,
 	.lp11_to_reset_delay_ms = 5,
+	.initial_power_off_delay_ms = 120,
 	.init_retries = 2,
 	.keep_powered_without_reset = true,
 	.prepare_prev_first = true,
diff --git a/drivers/phy/starfive/phy-jh7110-dphy-tx.c b/drivers/phy/starfive/phy-jh7110-dphy-tx.c
index 0ce39cb89f29..416f233bb701 100644
--- a/drivers/phy/starfive/phy-jh7110-dphy-tx.c
+++ b/drivers/phy/starfive/phy-jh7110-dphy-tx.c
@@ -9,6 +9,7 @@
 
 #include <linux/bitfield.h>
 #include <linux/clk.h>
+#include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
 #include <linux/mfd/syscon.h>
@@ -80,7 +81,8 @@
 #define STF_DPHY_LSHIFT_8(x)				(FIELD_PREP(GENMASK(15, 8), (x)))
 
 #define STF_DPHY_HW_DELAY_US				200
-#define STF_DPHY_HW_TIMEOUT_US				5000
+#define STF_DPHY_HW_TIMEOUT_US				20000
+#define STF_DPHY_PLL_LOCK_RETRIES			3
 
 struct stf_dphy_config {
 	unsigned long bitrate;
@@ -231,9 +233,6 @@ static int stf_dphy_hw_reset(struct stf_dphy *dphy, bool deassert)
 				 STF_DPHY_APBIFSAIF_SYSCFG(8), status,
 				 !(status & STF_DPHY_RGS_CDTX_PLL_UNLOCK),
 				 STF_DPHY_HW_DELAY_US, STF_DPHY_HW_TIMEOUT_US);
-	if (ret)
-		dev_err(dphy->dev, "MIPI D-PHY TX PLL failed to lock\n");
-
 	return ret;
 }
 
@@ -347,12 +346,29 @@ static int stf_dphy_exit(struct phy *phy)
 static int stf_dphy_power_on(struct phy *phy)
 {
 	struct stf_dphy *dphy = phy_get_drvdata(phy);
+	unsigned int attempt;
 	int ret;
 
 	/* Start the configured PLL and do not release the link before lock. */
-	ret = stf_dphy_hw_reset(dphy, true);
-	if (ret)
+	for (attempt = 0; attempt < STF_DPHY_PLL_LOCK_RETRIES; attempt++) {
+		ret = stf_dphy_hw_reset(dphy, true);
+		if (!ret)
+			break;
+
+		stf_dphy_hw_reset(dphy, false);
+		if (attempt + 1 < STF_DPHY_PLL_LOCK_RETRIES) {
+			dev_warn(dphy->dev,
+				 "MIPI D-PHY TX PLL lock attempt %u/%u timed out\n",
+				 attempt + 1, STF_DPHY_PLL_LOCK_RETRIES);
+			usleep_range(1000, 2000);
+		}
+	}
+	if (ret) {
+		dev_err(dphy->dev,
+			"MIPI D-PHY TX PLL failed to lock after %u attempts\n",
+			STF_DPHY_PLL_LOCK_RETRIES);
 		goto assert_dphy_reset;
+	}
 
 	writel(FIELD_PREP(STF_DPHY_SCFG_PPI_C_READY_SEL, 0) |
 	       FIELD_PREP(STF_DPHY_SCFG_DSI_TXREADY_ESC_SEL, 0),
-- 
2.55.0
