From ada13a02ff58c0a340a181f73facdd3714258768 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Machado?= <machaddr@falanet.org>
Date: Mon, 24 Aug 2026 19:25:00 +0100
Subject: [PATCH] drm/panel: boe-th101mb31ig002: establish LP-11 before reset
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The TH101MB31 panel power sequence requires the DSI lanes to be in LP-11
before hardware reset is released.  The PineTab-V descriptor currently
powers VCI through its enable GPIO, waits for the rail to settle and then
resets the panel before the first DSI transfer initializes the link.

The existing lp11_before_reset option sends its NOP before the enable
GPIO is asserted, so it cannot represent this board sequence.  Add an
after-enable variant and use it for PineTab-V.  Keep the existing 250 ms
rail delay, establish LP-11, wait another 5 ms, then issue the existing
reset pulse and initialization commands.

Assisted-by: Codex:gpt-5
Signed-off-by: André Machado <machaddr@falanet.org>
---
 .../drm/panel/panel-boe-th101mb31ig002-28a.c  | 19 ++++++++++++++++---
 1 file changed, 16 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c b/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c
index 73f713a78..831f2c6fa 100644
--- a/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c
+++ b/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c
@@ -28,6 +28,7 @@ struct panel_desc {
 	int (*init)(struct boe_th101mb31ig002 *ctx);
 	unsigned int lanes;
 	bool lp11_before_reset;
+	bool lp11_after_enable;
 	unsigned int vcioo_to_lp11_delay_ms;
 	unsigned int lp11_to_reset_delay_ms;
 	unsigned int enable_to_reset_delay_ms;
@@ -253,16 +254,26 @@ static int boe_th101mb31ig002_prepare(struct drm_panel *panel)
 		mipi_dsi_dcs_nop_multi(&dsi_ctx);
 		if (dsi_ctx.accum_err)
 			return dsi_ctx.accum_err;
-	}
 
-	if (ctx->desc->lp11_to_reset_delay_ms)
-		msleep(ctx->desc->lp11_to_reset_delay_ms);
+		if (ctx->desc->lp11_to_reset_delay_ms)
+			msleep(ctx->desc->lp11_to_reset_delay_ms);
+	}
 
 	gpiod_set_value_cansleep(ctx->enable, 1);
 	if (ctx->desc->enable_to_reset_delay_ms)
 		msleep(ctx->desc->enable_to_reset_delay_ms);
 	else
 		msleep(50);
+
+	if (ctx->desc->lp11_after_enable) {
+		mipi_dsi_dcs_nop_multi(&dsi_ctx);
+		if (dsi_ctx.accum_err)
+			return dsi_ctx.accum_err;
+
+		if (ctx->desc->lp11_to_reset_delay_ms)
+			msleep(ctx->desc->lp11_to_reset_delay_ms);
+	}
+
 	boe_th101mb31ig002_reset(ctx);
 
 	ret = ctx->desc->init(ctx);
@@ -324,6 +335,8 @@ static const struct panel_desc pinetab_v_desc = {
 	.bus_flags = DRM_BUS_FLAG_DE_LOW,
 	.init = boe_th101mb31ig002_enable,
 	.enable_to_reset_delay_ms = 250,
+	.lp11_after_enable = true,
+	.lp11_to_reset_delay_ms = 5,
 	.keep_powered_without_reset = true,
 };
 
