 drivers/gpu/drm/imagination/pvr_job.c | 44 ++++++------------
 drivers/gpu/drm/imagination/pvr_vm.c  | 85 ++++++++++++++++++++++++++++++++++-
 drivers/gpu/drm/imagination/pvr_vm.h  |  2 +-
 3 files changed, 99 insertions(+), 32 deletions(-)

