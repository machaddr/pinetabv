From 67aa1b9bc88144c6adecbbf35228b71793736360 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Machado?= <machaddr@falanet.org>
Date: Sat, 1 Aug 2026 16:57:37 +0100
Subject: [PATCH 36/53] dt-bindings: media: i2c: add GalaxyCore GC02M2

Describe the GC02M2 raw Bayer sensor, its three required supplies,
24 MHz input clock, reset and power-down GPIOs, and single-lane CSI-2
endpoint.

Assisted-by: Codex:gpt-5
---
 .../bindings/media/i2c/galaxycore,gc02m2.yaml | 112 ++++++++++++++++++
 1 file changed, 112 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/galaxycore,gc02m2.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/galaxycore,gc02m2.yaml b/Documentation/devicetree/bindings/media/i2c/galaxycore,gc02m2.yaml
new file mode 100644
index 0000000000000..2d9d33ae6ec21
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/galaxycore,gc02m2.yaml
@@ -0,0 +1,112 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/galaxycore,gc02m2.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: GalaxyCore GC02M2 2-megapixel MIPI CSI-2 image sensor
+
+maintainers:
+  - Linux Media Mailing List <linux-media@vger.kernel.org>
+
+description:
+  The GC02M2 is a raw Bayer image sensor controlled over an I2C-compatible
+  CCI bus. It provides a single-lane MIPI CSI-2 output.
+
+properties:
+  compatible:
+    const: galaxycore,gc02m2
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: xvclk
+
+  avdd-supply:
+    description: Analog power supply.
+
+  dovdd-supply:
+    description: Digital I/O power supply.
+
+  dvdd-supply:
+    description: Digital core power supply.
+
+  reset-gpios:
+    description: GPIO connected to the sensor reset input.
+    maxItems: 1
+
+  powerdown-gpios:
+    description: GPIO connected to the sensor power-down input.
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+
+          link-frequencies:
+            items:
+              - const: 336000000
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - avdd-supply
+  - dovdd-supply
+  - dvdd-supply
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@37 {
+            compatible = "galaxycore,gc02m2";
+            reg = <0x37>;
+            clocks = <&camera_clk>;
+            clock-names = "xvclk";
+            avdd-supply = <&camera_avdd>;
+            dovdd-supply = <&camera_dovdd>;
+            dvdd-supply = <&camera_dvdd>;
+            reset-gpios = <&gpio0 33 GPIO_ACTIVE_HIGH>;
+            powerdown-gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
+
+            port {
+                gc02m2_out: endpoint {
+                    data-lanes = <1>;
+                    link-frequencies = /bits/ 64 <336000000>;
+                    remote-endpoint = <&csi2rx_in>;
+                };
+            };
+        };
+    };
+
+...
-- 
