From b2ea08b5e8a6319c90a17c03e25b47dc5c8b81f9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Machado?= <machaddr@falanet.org>
Date: Sat, 22 Aug 2026 16:54:16 +0100
Subject: [PATCH 77/77] 8021q: reject generated VLAN names that exceed IFNAMSIZ

A VLAN name derived from a maximum-length lower-device name can exceed
IFNAMSIZ once the dot and VLAN ID are appended. Format into a temporary
buffer large enough for the worst case, then reject names that the
network-device ABI cannot represent instead of passing a truncated name
to alloc_netdev().

All representable names retain their existing spelling. Overlong names
now fail with -ENAMETOOLONG rather than risking a truncated-name
collision.

Assisted-by: Codex:gpt-5
---
 net/8021q/vlan.c | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/net/8021q/vlan.c b/net/8021q/vlan.c
index 2b74ed56eb166..51cc2bdfe0ac7 100644
--- a/net/8021q/vlan.c
+++ b/net/8021q/vlan.c
@@ -219,7 +219,7 @@ static int register_vlan_device(struct net_device *real_dev, u16 vlan_id)
 	struct vlan_dev_priv *vlan;
 	struct net *net = dev_net(real_dev);
 	struct vlan_net *vn = net_generic(net, vlan_net_id);
-	char name[IFNAMSIZ];
+	char name[IFNAMSIZ + sizeof(".4095") - 1];
 	int err;
 
 	if (vlan_id >= VLAN_VID_MASK)
@@ -234,27 +234,31 @@ static int register_vlan_device(struct net_device *real_dev, u16 vlan_id)
 	switch (vn->name_type) {
 	case VLAN_NAME_TYPE_RAW_PLUS_VID:
 		/* name will look like:	 eth1.0005 */
-		snprintf(name, IFNAMSIZ, "%s.%.4i", real_dev->name, vlan_id);
+		err = snprintf(name, sizeof(name), "%s.%.4i", real_dev->name,
+			       vlan_id);
 		break;
 	case VLAN_NAME_TYPE_PLUS_VID_NO_PAD:
 		/* Put our vlan.VID in the name.
 		 * Name will look like:	 vlan5
 		 */
-		snprintf(name, IFNAMSIZ, "vlan%i", vlan_id);
+		err = snprintf(name, sizeof(name), "vlan%i", vlan_id);
 		break;
 	case VLAN_NAME_TYPE_RAW_PLUS_VID_NO_PAD:
 		/* Put our vlan.VID in the name.
 		 * Name will look like:	 eth0.5
 		 */
-		snprintf(name, IFNAMSIZ, "%s.%i", real_dev->name, vlan_id);
+		err = snprintf(name, sizeof(name), "%s.%i", real_dev->name,
+			       vlan_id);
 		break;
 	case VLAN_NAME_TYPE_PLUS_VID:
 		/* Put our vlan.VID in the name.
 		 * Name will look like:	 vlan0005
 		 */
 	default:
-		snprintf(name, IFNAMSIZ, "vlan%.4i", vlan_id);
+		err = snprintf(name, sizeof(name), "vlan%.4i", vlan_id);
 	}
+	if (err >= IFNAMSIZ)
+		return -ENAMETOOLONG;
 
 	new_dev = alloc_netdev(sizeof(struct vlan_dev_priv), name,
 			       NET_NAME_UNKNOWN, vlan_setup);
