+		dev_err_ratelimited(video->stfcamss->dev,
+				    "%s: buffer %ux%u %p4cc differs from source %ux%u %p4cc\n",
+			video->vdev.name, pix->width, pix->height, &pix->pixelformat,
+			sd_fmt.format.width, sd_fmt.format.height, &fi->pixelformat);
