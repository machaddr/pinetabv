+	if (stf_video_is_yuv(video)) {
+		struct v4l2_mbus_framefmt bounds;
+		int ret;
+
+		mutex_lock(&video->stfcamss->media_dev.graph_mutex);
+		ret = stf_video_isp_bounds(video, &bounds);
+		mutex_unlock(&video->stfcamss->media_dev.graph_mutex);
+		if (ret)
+			return ret;
+
+		fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+		fsize->stepwise.min_width = STFCAMSS_FRAME_MIN_WIDTH;
+		fsize->stepwise.max_width = bounds.width & ~7;
