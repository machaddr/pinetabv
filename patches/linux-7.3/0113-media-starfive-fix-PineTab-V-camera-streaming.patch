 static void stf_capture_stop(struct stfcamss_video *video)
 {
 	struct stf_capture *cap = to_stf_capture(video);
-
-	if (cap->type == STF_CAPTURE_RAW)
+	struct stfcamss *stfcamss = video->stfcamss;
+
+	/* An ISR may write back a saved ISP_CTRL value with DMA still enabled. */
+	if (cap->type == STF_CAPTURE_RAW) {
+		disable_irq(stfcamss->irq[0]);
+		stf_syscon_reg_clear_bit(stfcamss, VIN_CHANNEL_SEL_EN,
+					 U0_VIN_AXIWR0_EN);
 		stf_wr_irq_disable(video);
+	} else {
+		disable_irq(stfcamss->irq[1]);
+		disable_irq(stfcamss->irq[2]);
+		stf_isp_reg_set_bit(stfcamss, ISP_REG_CSI_INPUT_EN_AND_STATUS,
+				    CSI_EN_S, 0);
+		stf_isp_reg_set_bit(stfcamss, ISP_REG_ISP_CTRL_0,
+				    ISPC_ENUO | ISPC_ENLS | ISPC_EN, 0);
+	}
 
 	stf_cap_s_cleanup(video);
+
+	if (cap->type == STF_CAPTURE_RAW) {
+		enable_irq(stfcamss->irq[0]);
+	} else {
+		enable_irq(stfcamss->irq[2]);
+		enable_irq(stfcamss->irq[1]);
+	}
 }
 
