+
+/* Initialize from the sensor only after all nested notifiers have bound. */
+static int stfcamss_init_pipeline_formats(struct v4l2_subdev *sd)
+{
+	struct v4l2_subdev_format format = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+	};
+	struct v4l2_subdev *upstream;
+	struct media_pad *pad, *remote;
+	int ret;
+
+	media_entity_for_each_pad(&sd->entity, pad) {
+		if (!(pad->flags & MEDIA_PAD_FL_SINK))
+			continue;
+
+		remote = media_pad_remote_pad_first(pad);
+		if (!remote || !is_media_entity_v4l2_subdev(remote->entity))
+			continue;
+
+		upstream = media_entity_to_v4l2_subdev(remote->entity);
+		ret = stfcamss_init_pipeline_formats(upstream);
+		if (ret)
+			return ret;
+
+		format.pad = remote->index;
+		ret = v4l2_subdev_call_state_active(upstream, pad, get_fmt,
+						    &format);
+		if (ret)
+			return ret;
+
+		format.pad = pad->index;
+		ret = v4l2_subdev_call_state_active(sd, pad, set_fmt, &format);
+		if (ret)
+			return ret;
+	}
 
 	return 0;
 }
