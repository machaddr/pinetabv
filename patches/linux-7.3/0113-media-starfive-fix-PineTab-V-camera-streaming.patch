+		struct stfcamss_video *video = &stfcamss->captures[i].video;
+
+		if (!video->source_subdev)
+			return -ENOLINK;
+
+		format.pad = video->source_pad;
+		ret = v4l2_subdev_call_state_active(video->source_subdev, pad,
+						    get_fmt, &format);
+		if (ret)
+			return ret;
+
+		ret = stf_video_init_format(video, &format.format);
+		if (ret)
+			return ret;
+	}
 
 	return v4l2_device_register_subdev_nodes(&stfcamss->v4l2_dev);
 }
