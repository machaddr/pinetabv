--- /dev/null
+++ b/arch/riscv/boot/dts/starfive/jh7110-pine64-pinetab-v-20240730.dts
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0 OR MIT
+/*
+ * Copyright (C) 2022 StarFive Technology Co., Ltd.
+ * Copyright (C) 2022 Hal Feng <hal.feng@starfivetech.com>
+ */
+
+/dts-v1/;
+
+#include "jh7110-pine64-pinetab-v.dtsi"
+
+/ {
+	model = "Pine64 PineTab-V (2024-07-30)";
+	compatible = "pine64,pinetab-v-20240730", "pine64,pinetab-v",
+		     "starfive,jh7110";
+};
+
+&gpio_keys {
+	volume-down-key {
+		label = "Volume down";
+		linux,code = <KEY_VOLUMEDOWN>;
+		gpios = <&aongpio 0 GPIO_ACTIVE_HIGH>;
+		debounce-interval = <10>;
+	};
+};
+
+&i2c0 {
+	accelerometer@18 {
+		compatible = "silan,sc7a20";
+		reg = <0x18>;
+		vdd-supply = <&gpio_vdd>;
+		vddio-supply = <&gpio_vdd>;
+		mount-matrix = "0", "0", "-1",
+			       "1", "0", "0",
+			       "0", "-1", "0";
+	};
+};
+
+&panel {
