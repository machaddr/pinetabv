From 3497bf666786d582ef29eaa8536ee14b6bd1d657 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Machado?= <machaddr@falanet.org>
Date: Tue, 11 Aug 2026 09:18:13 +0100
Subject: [PATCH 3/8] drm/panel: boe-th101: add PineTab-V panel timings

The active PineTab-V vendor Linux Jadard driver describes a 66 MHz pixel
clock, 44/5/5 horizontal porches, and 5/5/5 vertical porches. It uses
sync-pulse video with a non-continuous clock and marks data-enable active
low. PineTab-V U-Boot independently confirms the timing values; its DSI
host flags are not carried over.

Keep the generic BOE mode unchanged and select the board data through
the PineTab-V compatible. Honor the vendor's 250 ms enable-to-reset
delay. The first PineTab-V revision has no panel reset line, so retain
power across unprepare as the vendor driver does. Track the regulator
state so subsequent prepare calls do not imbalance its enable count,
and power the retained supply down when removing the driver.

Assisted-by: Codex:gpt-5
---
 .../drm/panel/panel-boe-th101mb31ig002-28a.c  | 70 +++++++++++++++++--
 1 file changed, 64 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c b/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c
index c6a7767d5035a..73f713a78c481 100644
--- a/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c
+++ b/drivers/gpu/drm/panel/panel-boe-th101mb31ig002-28a.c
@@ -23,15 +23,18 @@ struct boe_th101mb31ig002;
 struct panel_desc {
 	const struct drm_display_mode *modes;
 	unsigned long mode_flags;
+	u32 bus_flags;
 	enum mipi_dsi_pixel_format format;
 	int (*init)(struct boe_th101mb31ig002 *ctx);
 	unsigned int lanes;
 	bool lp11_before_reset;
 	unsigned int vcioo_to_lp11_delay_ms;
 	unsigned int lp11_to_reset_delay_ms;
+	unsigned int enable_to_reset_delay_ms;
 	unsigned int backlight_off_to_display_off_delay_ms;
 	unsigned int enter_sleep_to_reset_down_delay_ms;
 	unsigned int power_off_delay_ms;
+	bool keep_powered_without_reset;
 };
 
 struct boe_th101mb31ig002 {
@@ -44,6 +47,7 @@ struct boe_th101mb31ig002 {
 	struct regulator *power;
 	struct gpio_desc *enable;
 	struct gpio_desc *reset;
+	bool powered;
 
 	enum drm_panel_orientation orientation;
 };
@@ -208,9 +212,14 @@ static int boe_th101mb31ig002_unprepare(struct drm_panel *panel)
 						      struct boe_th101mb31ig002,
 						      panel);
 
-	gpiod_set_value_cansleep(ctx->reset, 1);
+	if (ctx->desc->keep_powered_without_reset && !ctx->reset)
+		return 0;
+
+	if (ctx->reset)
+		gpiod_set_value_cansleep(ctx->reset, 1);
 	gpiod_set_value_cansleep(ctx->enable, 0);
 	regulator_disable(ctx->power);
+	ctx->powered = false;
 
 	if (ctx->desc->power_off_delay_ms)
 		msleep(ctx->desc->power_off_delay_ms);
@@ -227,10 +236,14 @@ static int boe_th101mb31ig002_prepare(struct drm_panel *panel)
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 	int ret;
 
-	ret = regulator_enable(ctx->power);
-	if (ret) {
-		dev_err(dev, "Failed to enable power supply: %d\n", ret);
-		return ret;
+	if (!ctx->powered) {
+		ret = regulator_enable(ctx->power);
+		if (ret) {
+			dev_err(dev, "Failed to enable power supply: %d\n", ret);
+			return ret;
+		}
+
+		ctx->powered = true;
 	}
 
 	if (ctx->desc->vcioo_to_lp11_delay_ms)
@@ -246,7 +259,10 @@ static int boe_th101mb31ig002_prepare(struct drm_panel *panel)
 		msleep(ctx->desc->lp11_to_reset_delay_ms);
 
 	gpiod_set_value_cansleep(ctx->enable, 1);
-	msleep(50);
+	if (ctx->desc->enable_to_reset_delay_ms)
+		msleep(ctx->desc->enable_to_reset_delay_ms);
+	else
+		msleep(50);
 	boe_th101mb31ig002_reset(ctx);
 
 	ret = ctx->desc->init(ctx);
@@ -282,6 +298,35 @@ static const struct panel_desc boe_th101mb31ig002_desc = {
 	.init = boe_th101mb31ig002_enable,
 };
 
+static const struct drm_display_mode pinetab_v_default_mode = {
+	.clock		= 66000,
+	.hdisplay	= 800,
+	.hsync_start	= 800 + 44,
+	.hsync_end	= 800 + 44 + 5,
+	.htotal		= 800 + 44 + 5 + 5,
+	.vdisplay	= 1280,
+	.vsync_start	= 1280 + 5,
+	.vsync_end	= 1280 + 5 + 5,
+	.vtotal		= 1280 + 5 + 5 + 5,
+	.width_mm	= 135,
+	.height_mm	= 216,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static const struct panel_desc pinetab_v_desc = {
+	.modes = &pinetab_v_default_mode,
+	.lanes = 4,
+	.format = MIPI_DSI_FMT_RGB888,
+	.mode_flags = MIPI_DSI_MODE_VIDEO |
+		      MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+		      MIPI_DSI_CLOCK_NON_CONTINUOUS |
+		      MIPI_DSI_MODE_LPM,
+	.bus_flags = DRM_BUS_FLAG_DE_LOW,
+	.init = boe_th101mb31ig002_enable,
+	.enable_to_reset_delay_ms = 250,
+	.keep_powered_without_reset = true,
+};
+
 static const struct drm_display_mode starry_er88577_default_mode = {
 	.clock	= (800 + 25 + 25 + 25) * (1280 + 20 + 4 + 12) * 60 / 1000,
 	.hdisplay = 800,
@@ -321,6 +366,7 @@ static int boe_th101mb31ig002_get_modes(struct drm_panel *panel,
 	const struct drm_display_mode *desc_mode = ctx->desc->modes;
 
 	connector->display_info.bpc = 8;
+	connector->display_info.bus_flags = ctx->desc->bus_flags;
 	/*
 	 * TODO: Remove once all drm drivers call
 	 * drm_connector_set_orientation_from_panel()
@@ -412,11 +458,23 @@ static void boe_th101mb31ig002_dsi_remove(struct mipi_dsi_device *dsi)
 {
 	struct boe_th101mb31ig002 *ctx = mipi_dsi_get_drvdata(dsi);
 
+	if (ctx->powered) {
+		if (ctx->reset)
+			gpiod_set_value_cansleep(ctx->reset, 1);
+		gpiod_set_value_cansleep(ctx->enable, 0);
+		regulator_disable(ctx->power);
+		ctx->powered = false;
+	}
+
 	mipi_dsi_detach(dsi);
 	drm_panel_remove(&ctx->panel);
 }
 
 static const struct of_device_id boe_th101mb31ig002_of_match[] = {
+	{
+		.compatible = "boe,th101mb31ig002-28a-pinetab-v",
+		.data = &pinetab_v_desc
+	},
 	{
 		.compatible = "boe,th101mb31ig002-28a",
 		.data = &boe_th101mb31ig002_desc
-- 
