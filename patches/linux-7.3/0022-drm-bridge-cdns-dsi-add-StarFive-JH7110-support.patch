diff --git a/drivers/gpu/drm/bridge/cadence/cdns-dsi-jh7110.c b/drivers/gpu/drm/bridge/cadence/cdns-dsi-jh7110.c
new file mode 100644
index 0000000000000..b3b5baa8b1b33
--- /dev/null
+++ b/drivers/gpu/drm/bridge/cadence/cdns-dsi-jh7110.c
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * StarFive JH7110 Cadence DSI wrapper
+ *
+ * Copyright (C) 2022-2024 StarFive Technology Co., Ltd.
+ */
+
+#include <linux/clk.h>
+#include <linux/math64.h>
+#include <linux/reset.h>
+#include <video/videomode.h>
+
+#include "cdns-dsi-jh7110.h"
+
+#define JH7110_DPHY_RATE_STEP	100000000UL
+
+static const char * const dsi_resets[] = {
+	"sys",
+	"dpi",
+	"txesc",
+	"txbytehs",
+};
+
+static const char * const dsi_clocks[] = {
+	"dpi",
+	"txesc",
+};
+
+static int cdns_dsi_jh7110_init(struct cdns_dsi *dsi)
+{
+	struct device *dev = dsi->base.dev;
+	int i;
+	int ret;
+
+	dsi->num_clks = ARRAY_SIZE(dsi_clocks);
+	dsi->clocks = devm_kcalloc(dev, dsi->num_clks,
+				   sizeof(*dsi->clocks), GFP_KERNEL);
+	if (!dsi->clocks)
+		return -ENOMEM;
+
+	for (i = 0; i < dsi->num_clks; i++)
+		dsi->clocks[i].id = dsi_clocks[i];
+
+	ret = devm_clk_bulk_get(dev, dsi->num_clks, dsi->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get wrapper clocks\n");
+
+	dsi->num_rsts = ARRAY_SIZE(dsi_resets);
+	dsi->resets = devm_kcalloc(dev, dsi->num_rsts,
+				   sizeof(*dsi->resets), GFP_KERNEL);
+	if (!dsi->resets)
+		return -ENOMEM;
+
+	for (i = 0; i < dsi->num_rsts; i++)
+		dsi->resets[i].id = dsi_resets[i];
+
+	ret = devm_reset_control_bulk_get_exclusive(dev, dsi->num_rsts,
+						    dsi->resets);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get wrapper resets\n");
+
+	return 0;
+}
+
+static int cdns_dsi_jh7110_resume(struct cdns_dsi *dsi)
+{
+	int ret;
+
+	ret = clk_bulk_prepare_enable(dsi->num_clks, dsi->clocks);
+	if (ret)
+		return ret;
+
+	/* TXBYTEHS stays asserted until the D-PHY has entered HS mode. */
+	ret = reset_control_bulk_deassert(dsi->num_rsts - 1, dsi->resets);
+	if (ret)
+		clk_bulk_disable_unprepare(dsi->num_clks, dsi->clocks);
+
+	return ret;
+}
+
+static void cdns_dsi_jh7110_suspend(struct cdns_dsi *dsi)
+{
+	int ret;
+
+	/* Stop the byte clock before powering down the active D-PHY. */
+	ret = reset_control_assert(dsi->resets[dsi->num_rsts - 1].rstc);
+	if (ret)
+		dev_err(dsi->base.dev, "failed to assert TXBYTEHS reset: %d\n",
+			ret);
+
+	if (dsi->phy_initialized) {
+		ret = phy_power_off(dsi->dphy);
+		if (ret)
+			dev_err(dsi->base.dev, "failed to power off D-PHY: %d\n",
+				ret);
+
+		ret = phy_exit(dsi->dphy);
+		if (ret)
+			dev_err(dsi->base.dev, "failed to exit D-PHY: %d\n", ret);
+
+		dsi->phy_initialized = false;
+	}
+
+	/* The wrapper resets below discard all Cadence link state. */
+	dsi->link_initialized = false;
+
+	reset_control_bulk_assert(dsi->num_rsts, dsi->resets);
+	clk_bulk_disable_unprepare(dsi->num_clks, dsi->clocks);
+}
+
+static int cdns_dsi_jh7110_mode_fixup(struct cdns_dsi *dsi,
+				      const struct videomode *vm,
+				      struct cdns_dsi_cfg *dsi_cfg,
+				      struct phy_configure_opts_mipi_dphy *phy_cfg)
+{
+	u64 adjusted_htotal;
+	u64 dpi_htotal;
+	unsigned long lane_rate;
+	unsigned int lanes = dsi->output.dev->lanes;
+
+	if (!vm->pixelclock)
+		return -EINVAL;
+
+	/* The JH7110 D-PHY can only synthesize 100 MHz lane-rate steps. */
+	lane_rate = roundup(phy_cfg->hs_clk_rate, JH7110_DPHY_RATE_STEP);
+	phy_cfg->hs_clk_rate = lane_rate;
+
+	dpi_htotal = vm->hactive + vm->hfront_porch + vm->hsync_len +
+		     vm->hback_porch;
+	adjusted_htotal = DIV_ROUND_UP_ULL((u64)lane_rate * lanes * dpi_htotal,
+					   8ULL * vm->pixelclock);
+
+	if (adjusted_htotal > dsi_cfg->htotal) {
+		dsi_cfg->hfp += adjusted_htotal - dsi_cfg->htotal;
+		dsi_cfg->htotal = adjusted_htotal;
+	}
+
+	return 0;
+}
+
+static int cdns_dsi_jh7110_transfer(struct cdns_dsi *dsi)
+{
+	cdns_dsi_hs_init(dsi);
+
+	return reset_control_deassert(dsi->resets[dsi->num_rsts - 1].rstc);
+}
+
+const struct cdns_dsi_platform_ops dsi_jh7110_ops = {
+	.init = cdns_dsi_jh7110_init,
+	.resume = cdns_dsi_jh7110_resume,
+	.suspend = cdns_dsi_jh7110_suspend,
+	.mode_fixup = cdns_dsi_jh7110_mode_fixup,
+	.transfer = cdns_dsi_jh7110_transfer,
+};
