+static int gc02m2_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct gc02m2 *gc02m2 = to_gc02m2(sd);
+	struct v4l2_mbus_framefmt *state_fmt;
+	const struct gc02m2_mode *mode = &supported_modes[0];
+	s64 h_blank, vblank_def;
+
+	fmt->format.code = mode->bus_fmt;
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc =
+		V4L2_MAP_YCBCR_ENC_DEFAULT(fmt->format.colorspace);
+	fmt->format.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+
+	state_fmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*state_fmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	gc02m2->cur_mode = mode;
+	h_blank = mode->hts_def - mode->width;
+	__v4l2_ctrl_modify_range(gc02m2->hblank, h_blank, h_blank, 1, h_blank);
+	vblank_def = mode->vts_def - mode->height;
+	__v4l2_ctrl_modify_range(gc02m2->vblank, vblank_def,
+				 GC02M2_VTS_MAX - mode->height, 1, vblank_def);
+
+	return 0;
+}
+
+static int gc02m2_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = supported_modes[0].bus_fmt;
+
+	return 0;
+}
+
+static int gc02m2_enum_frame_sizes(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *sd_state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(supported_modes))
+		return -EINVAL;
+
+	if (fse->code != supported_modes[0].bus_fmt)
+		return -EINVAL;
+
+	fse->min_width = supported_modes[fse->index].width;
+	fse->max_width = supported_modes[fse->index].width;
+	fse->max_height = supported_modes[fse->index].height;
+	fse->min_height = supported_modes[fse->index].height;
+
+	return 0;
+}
+
+static int gc02m2_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+	};
+
+	return gc02m2_set_fmt(sd, state, &fmt);
+}
+
+/* Calculate the delay in us by clock rate and clock cycles */
+static inline u32 gc02m2_cal_delay(u32 cycles)
+{
+	return DIV_ROUND_UP(cycles, GC02M2_XVCLK_FREQ / 1000 / 1000);
+}
+
+static int __gc02m2_power_on(struct gc02m2 *gc02m2)
+{
+	struct device *dev = &gc02m2->client->dev;
+	u32 delay_us;
+	int ret;
+
+	ret = clk_set_rate(gc02m2->xvclk, GC02M2_XVCLK_FREQ);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to set xvclk rate\n");
+
+	if (clk_get_rate(gc02m2->xvclk) != GC02M2_XVCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL, "xvclk must be 24 MHz\n");
+
+	ret = regulator_bulk_enable(GC02M2_NUM_SUPPLIES, gc02m2->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to enable regulators\n");
+
+	ret = clk_prepare_enable(gc02m2->xvclk);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "failed to enable xvclk\n");
+		goto disable_regulators;
+	}
+
+	if (gc02m2->pwdn_gpio)
+		gpiod_set_value_cansleep(gc02m2->pwdn_gpio, 0);
+	if (gc02m2->reset_gpio)
+		gpiod_set_value_cansleep(gc02m2->reset_gpio, 0);
+	usleep_range(500, 1000);
+
+	/* 8192 cycles prior to first SCCB transaction */
+	delay_us = gc02m2_cal_delay(8192);
+	usleep_range(delay_us, delay_us * 2);
+
+	return 0;
+
+disable_regulators:
+	regulator_bulk_disable(GC02M2_NUM_SUPPLIES, gc02m2->supplies);
+	return ret;
+}
+
+static void __gc02m2_power_off(struct gc02m2 *gc02m2)
+{
+	if (gc02m2->reset_gpio)
+		gpiod_set_value_cansleep(gc02m2->reset_gpio, 1);
+	if (gc02m2->pwdn_gpio)
+		gpiod_set_value_cansleep(gc02m2->pwdn_gpio, 1);
+
+	clk_disable_unprepare(gc02m2->xvclk);
+	regulator_bulk_disable(GC02M2_NUM_SUPPLIES, gc02m2->supplies);
+}
+
+static int __gc02m2_start_stream(struct gc02m2 *gc02m2)
+{
+	int ret;
+
+	ret = gc02m2_write_array(gc02m2->client, gc02m2->cur_mode->reg_list);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_handler_setup(&gc02m2->ctrl_handler);
+	if (ret)
+		return ret;
+
+	ret = gc02m2_write_reg(gc02m2->client, GC02M2_PAGE_SELECT, 0x00);
+	if (ret)
+		return ret;
+
+	return gc02m2_write_reg(gc02m2->client, GC02M2_MODE_SELECT,
+				GC02M2_MODE_STREAMING);
+}
+
+static int __gc02m2_stop_stream(struct gc02m2 *gc02m2)
+{
+	int ret = gc02m2_write_reg(gc02m2->client, GC02M2_PAGE_SELECT, 0x00);
+
+	if (ret)
+		return ret;
+
+	return gc02m2_write_reg(gc02m2->client, GC02M2_MODE_SELECT,
+				GC02M2_MODE_SW_STANDBY);
+}
+
+static int gc02m2_s_stream(struct v4l2_subdev *sd, int on)
+{
+	struct gc02m2 *gc02m2 = to_gc02m2(sd);
+	struct i2c_client *client = gc02m2->client;
+	struct v4l2_subdev_state *state;
+	int ret = 0;
+
+	state = v4l2_subdev_lock_and_get_active_state(sd);
+	on = !!on;
+	if (on == gc02m2->streaming)
+		goto unlock_and_return;
+
+	if (on) {
+		ret = pm_runtime_resume_and_get(&client->dev);
+		if (ret < 0)
+			goto unlock_and_return;
+
+		ret = __gc02m2_start_stream(gc02m2);
+		if (ret) {
+			dev_err(&client->dev, "failed to start stream: %d\n",
+				ret);
+			pm_runtime_put(&client->dev);
+			goto unlock_and_return;
+		}
+	} else {
+		ret = __gc02m2_stop_stream(gc02m2);
+		pm_runtime_put(&client->dev);
+		gc02m2->streaming = false;
+	}
+
+	if (on && !ret)
+		gc02m2->streaming = on;
+
+unlock_and_return:
+	v4l2_subdev_unlock_state(state);
+
+	return ret;
+}
+
+static int gc02m2_runtime_resume(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc02m2 *gc02m2 = to_gc02m2(sd);
+
+	return __gc02m2_power_on(gc02m2);
+}
+
+static int gc02m2_runtime_suspend(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc02m2 *gc02m2 = to_gc02m2(sd);
+
+	__gc02m2_power_off(gc02m2);
+
+	return 0;
+}
+
+static int
+gc02m2_enum_frame_interval(struct v4l2_subdev *sd,
+			   struct v4l2_subdev_state *sd_state,
+			   struct v4l2_subdev_frame_interval_enum *fie)
+{
+	if (fie->index >= ARRAY_SIZE(supported_modes))
+		return -EINVAL;
+	if (fie->pad || fie->code != supported_modes[fie->index].bus_fmt)
+		return -EINVAL;
+
+	fie->code = supported_modes[fie->index].bus_fmt;
+	fie->width = supported_modes[fie->index].width;
+	fie->height = supported_modes[fie->index].height;
+	fie->interval = supported_modes[fie->index].max_fps;
+	return 0;
+}
+
+static const struct dev_pm_ops gc02m2_pm_ops = {
+	SET_RUNTIME_PM_OPS(gc02m2_runtime_suspend,
+			   gc02m2_runtime_resume, NULL)
+};
+
+static const struct v4l2_subdev_internal_ops gc02m2_internal_ops = {
+	.init_state = gc02m2_init_state,
+};
+
+static const struct v4l2_subdev_video_ops gc02m2_video_ops = {
+	.s_stream = gc02m2_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops gc02m2_pad_ops = {
+	.enum_mbus_code = gc02m2_enum_mbus_code,
+	.enum_frame_size = gc02m2_enum_frame_sizes,
+	.enum_frame_interval = gc02m2_enum_frame_interval,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc02m2_set_fmt,
+};
+
+static const struct v4l2_subdev_ops gc02m2_subdev_ops = {
+	.video = &gc02m2_video_ops,
+	.pad = &gc02m2_pad_ops,
+};
+
+#define GC02M2_DIGITAL_GAIN_BASE 1024
+
+static int gc02m2_set_gain_reg(struct gc02m2 *gc02m2, u32 total_gain)
+{
+	struct device *dev = &gc02m2->client->dev;
+	u32 dgain;
+	int i, ret;
+
+	total_gain = max_t(u32, total_gain, GC02M2_GAIN_MIN);
+
+	for (i = 15; i >= 0; i--) {
+		if (total_gain >= gc02m2_agc_params[i][0] &&
+		    total_gain < gc02m2_agc_params[i + 1][0])
+			break;
+	}
+
+	ret = gc02m2_write_reg(gc02m2->client, GC02M2_PAGE_SELECT, 0x00);
+	if (ret)
+		return ret;
+
+	ret = gc02m2_write_reg(gc02m2->client, GC02M2_ANALOG_GAIN_REG,
+			       gc02m2_agc_params[i][1]);
+	if (ret)
+		return ret;
+
+	dgain = total_gain * GC02M2_DIGITAL_GAIN_BASE / gc02m2_agc_params[i][0];
+	dev_dbg(dev, "gain %u, analog index %d, digital gain %#x\n", total_gain,
+		i, dgain);
+
+	ret = gc02m2_write_reg(gc02m2->client, GC02M2_PREGAIN_H_REG,
+			       dgain >> 8);
+	if (ret)
+		return ret;
+
+	return gc02m2_write_reg(gc02m2->client, GC02M2_PREGAIN_L_REG,
+				dgain & 0xff);
+}
+
+static int gc02m2_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc02m2 *gc02m2 =
+		container_of(ctrl->handler, struct gc02m2, ctrl_handler);
+	struct i2c_client *client = gc02m2->client;
+	s64 max;
+	u32 vts;
+	u8 mask, val;
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Update max exposure while meeting expected vblanking */
+		max = gc02m2->cur_mode->height + ctrl->val - 16;
+		__v4l2_ctrl_modify_range(gc02m2->exposure,
+					 gc02m2->exposure->minimum, max,
+					 gc02m2->exposure->step,
+					 gc02m2->exposure->default_value);
+	}
+
+	if (!pm_runtime_get_if_active(&client->dev))
+		return 0;
+
+	ret = gc02m2_write_reg(client, GC02M2_PAGE_SELECT, 0x00);
+	if (ret)
+		goto out_pm_put;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = gc02m2_write_reg(client, GC02M2_REG_EXPOSURE_H,
+				       (ctrl->val >> 8) & 0x3f);
+		if (!ret)
+			ret = gc02m2_write_reg(client, GC02M2_REG_EXPOSURE_L,
+					       ctrl->val & 0xff);
+		break;
+
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = gc02m2_set_gain_reg(gc02m2, ctrl->val);
+		break;
+
+	case V4L2_CID_VBLANK:
+		vts = ctrl->val + gc02m2->cur_mode->height;
+		ret = gc02m2_write_reg(client, GC02M2_REG_VTS_H,
+				       (vts >> 8) & 0x3f);
+		if (!ret)
+			ret = gc02m2_write_reg(client, GC02M2_REG_VTS_L,
+					       vts & 0xff);
+		break;
+
+	case V4L2_CID_HFLIP:
+		mask = GC02M2_MIRROR_MASK;
+		goto update_flip;
+
+	case V4L2_CID_VFLIP:
+		mask = GC02M2_FLIP_MASK;
+update_flip:
+		ret = gc02m2_read_reg(client, GC02M2_MIRROR_FLIP_REG, &val);
+		if (!ret) {
+			if (ctrl->val)
+				val |= mask;
+			else
+				val &= ~mask;
+			ret = gc02m2_write_reg(client, GC02M2_MIRROR_FLIP_REG,
+					       val);
+		}
+		break;
+
+	default:
+		break;
+	}
+
+out_pm_put:
+	pm_runtime_put(&client->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc02m2_ctrl_ops = {
+	.s_ctrl = gc02m2_set_ctrl,
+};
+
+static int gc02m2_check_sensor_id(struct gc02m2 *gc02m2,
+				  struct i2c_client *client)
+{
+	struct device *dev = &gc02m2->client->dev;
+	unsigned int id;
+	u8 pid, ver;
+	int ret;
+
+	ret = gc02m2_read_reg(client, GC02M2_REG_CHIP_ID_H, &pid);
+	if (ret) {
+		dev_err(dev, "failed to read chip ID high byte\n");
+		return ret;
+	}
+
+	ret = gc02m2_read_reg(client, GC02M2_REG_CHIP_ID_L, &ver);
+	if (ret) {
+		dev_err(dev, "failed to read chip ID low byte\n");
+		return ret;
+	}
+
+	id = SENSOR_ID(pid, ver);
+	if (id != GC02M2_CHIP_ID) {
+		dev_err(dev, "unexpected sensor ID %#04x\n", id);
+		return -ENODEV;
+	}
+
+	dev_info(dev, "detected GC02M2 sensor\n");
+
+	return 0;
+}
+
+static int gc02m2_configure_regulators(struct gc02m2 *gc02m2)
+{
+	unsigned int i;
+
+	for (i = 0; i < GC02M2_NUM_SUPPLIES; i++)
+		gc02m2->supplies[i].supply = gc02m2_supply_names[i];
+
+	return devm_regulator_bulk_get(&gc02m2->client->dev,
+				       GC02M2_NUM_SUPPLIES, gc02m2->supplies);
+}
+
+static int gc02m2_parse_fwnode(struct gc02m2 *gc02m2)
+{
+	struct device *dev = &gc02m2->client->dev;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(dev, -EINVAL, "missing endpoint node\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to parse endpoint\n");
+		goto out;
+	}
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != GC02M2_LANES ||
+	    bus_cfg.bus.mipi_csi2.data_lanes[0] != 1 ||
+	    bus_cfg.nr_of_link_frequencies != 1 ||
+	    bus_cfg.link_frequencies[0] != GC02M2_MIPI_LINK_FREQ) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "endpoint must use lane 1 at 336 MHz\n");
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	fwnode_handle_put(endpoint);
+	return ret;
+}
+
+static int gc02m2_initialize_controls(struct gc02m2 *gc02m2)
+{
+	struct v4l2_fwnode_device_properties props;
+	const struct gc02m2_mode *mode;
+	struct v4l2_ctrl_handler *handler;
+	struct v4l2_ctrl *ctrl;
+	s64 exposure_max, vblank_def;
+	struct device *dev = &gc02m2->client->dev;
+	u32 h_blank;
+	int ret;
+
+	handler = &gc02m2->ctrl_handler;
+	mode = gc02m2->cur_mode;
+	ret = v4l2_ctrl_handler_init(handler, 10);
+	if (ret)
+		return ret;
+
+	handler->lock = &gc02m2->mutex;
+
+	ctrl = v4l2_ctrl_new_int_menu(handler, NULL, V4L2_CID_LINK_FREQ, 0, 0,
+				      link_freq_menu_items);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(handler, NULL, V4L2_CID_PIXEL_RATE, 0,
+			  GC02M2_PIXEL_RATE, 1, GC02M2_PIXEL_RATE);
+
+	h_blank = mode->hts_def - mode->width;
+	gc02m2->hblank = v4l2_ctrl_new_std(handler, NULL, V4L2_CID_HBLANK,
+					   h_blank, h_blank, 1, h_blank);
+	if (gc02m2->hblank)
+		gc02m2->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank_def = mode->vts_def - mode->height;
+	gc02m2->vblank = v4l2_ctrl_new_std(handler, &gc02m2_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank_def,
+					   GC02M2_VTS_MAX - mode->height, 1,
+					   vblank_def);
+
+	exposure_max = mode->vts_def - 16;
+	gc02m2->exposure =
+		v4l2_ctrl_new_std(handler, &gc02m2_ctrl_ops, V4L2_CID_EXPOSURE,
+				  GC02M2_EXPOSURE_MIN, exposure_max,
+				  GC02M2_EXPOSURE_STEP, mode->exp_def);
+
+	gc02m2->anal_gain = v4l2_ctrl_new_std(handler, &gc02m2_ctrl_ops,
+					      V4L2_CID_ANALOGUE_GAIN,
+					      GC02M2_GAIN_MIN, GC02M2_GAIN_MAX,
+					      GC02M2_GAIN_STEP,
+					      GC02M2_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(handler, &gc02m2_ctrl_ops, V4L2_CID_HFLIP, 0, 1, 1,
+			  0);
+
+	v4l2_ctrl_new_std(handler, &gc02m2_ctrl_ops, V4L2_CID_VFLIP, 0, 1, 1,
+			  0);
+
+	ret = v4l2_fwnode_device_parse(dev, &props);
+	if (ret)
+		goto err_free_handler;
+
+	ret = v4l2_ctrl_new_fwnode_properties(handler, &gc02m2_ctrl_ops,
+					      &props);
+	if (ret)
+		goto err_free_handler;
+
+	if (handler->error) {
+		ret = handler->error;
+		dev_err(dev, "failed to initialize controls: %d\n", ret);
+		goto err_free_handler;
+	}
+
+	gc02m2->subdev.ctrl_handler = handler;
+
+	return 0;
+
+err_free_handler:
+	v4l2_ctrl_handler_free(handler);
+
+	return ret;
+}
+
+static int gc02m2_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gc02m2 *gc02m2;
+	struct v4l2_subdev *sd;
+	int ret;
+
+	gc02m2 = devm_kzalloc(dev, sizeof(*gc02m2), GFP_KERNEL);
+	if (!gc02m2)
+		return -ENOMEM;
+
+	gc02m2->client = client;
+	gc02m2->cur_mode = &supported_modes[0];
+	ret = gc02m2_parse_fwnode(gc02m2);
+	if (ret)
+		return ret;
+
+	gc02m2->xvclk = devm_clk_get(dev, "xvclk");
+	if (IS_ERR(gc02m2->xvclk))
+		return dev_err_probe(dev, PTR_ERR(gc02m2->xvclk),
+				     "failed to get xvclk\n");
+
+	gc02m2->reset_gpio =
+		devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(gc02m2->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc02m2->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	gc02m2->pwdn_gpio =
+		devm_gpiod_get_optional(dev, "powerdown", GPIOD_OUT_HIGH);
+	if (IS_ERR(gc02m2->pwdn_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc02m2->pwdn_gpio),
+				     "failed to get power-down GPIO\n");
+
+	ret = gc02m2_configure_regulators(gc02m2);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	mutex_init(&gc02m2->mutex);
+
+	sd = &gc02m2->subdev;
+	v4l2_i2c_subdev_init(sd, client, &gc02m2_subdev_ops);
+	sd->internal_ops = &gc02m2_internal_ops;
+	sd->flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sd->entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	gc02m2->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = gc02m2_initialize_controls(gc02m2);
+	if (ret)
+		goto err_destroy_mutex;
+
+	ret = media_entity_pads_init(&sd->entity, 1, &gc02m2->pad);
+	if (ret)
+		goto err_free_handler;
+
+	sd->state_lock = gc02m2->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(sd);
+	if (ret)
+		goto err_clean_entity;
+
+	ret = __gc02m2_power_on(gc02m2);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	ret = gc02m2_check_sensor_id(gc02m2, client);
+	if (ret)
+		goto err_power_off;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_idle(dev);
+
+	ret = v4l2_async_register_subdev_sensor(sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register V4L2 subdevice\n");
+		goto err_pm;
+	}
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	if (!pm_runtime_status_suspended(dev))
+		__gc02m2_power_off(gc02m2);
+	pm_runtime_set_suspended(dev);
+	goto err_subdev_cleanup;
+err_power_off:
+	__gc02m2_power_off(gc02m2);
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(sd);
+err_clean_entity:
+	media_entity_cleanup(&sd->entity);
+err_free_handler:
+	v4l2_ctrl_handler_free(&gc02m2->ctrl_handler);
+err_destroy_mutex:
+	mutex_destroy(&gc02m2->mutex);
+
+	return ret;
+}
+
+static void gc02m2_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc02m2 *gc02m2 = to_gc02m2(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&gc02m2->ctrl_handler);
+	mutex_destroy(&gc02m2->mutex);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		__gc02m2_power_off(gc02m2);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id gc02m2_of_match[] = {
+	{ .compatible = "galaxycore,gc02m2" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, gc02m2_of_match);
+
+static const struct i2c_device_id gc02m2_match_id[] = { { "gc02m2" }, {} };
+
+static struct i2c_driver gc02m2_i2c_driver = {
+	.driver = {
+		.name = GC02M2_NAME,
+		.pm = &gc02m2_pm_ops,
+		.of_match_table = gc02m2_of_match,
+	},
+	.probe		= gc02m2_probe,
+	.remove		= gc02m2_remove,
+	.id_table	= gc02m2_match_id,
+};
+
+module_i2c_driver(gc02m2_i2c_driver);
+
+MODULE_DESCRIPTION("GalaxyCore GC02M2 image sensor driver");
+MODULE_LICENSE("GPL");
