From 6a21e2d4c2825b30df2fab7077f1fa05f86a2825 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Machado?= <machaddr@falanet.org>
Date: Sat, 1 Aug 2026 16:40:50 +0100
Subject: [PATCH 40/53] dt-bindings: power: supply: add SouthChip SC89890H

Add the SouthChip vendor prefix and SC89890H compatible to the BQ25890
family binding. The device shares the register layout but uses different
current and voltage encodings.

Assisted-by: Codex:gpt-5
---
 Documentation/devicetree/bindings/power/supply/bq25890.yaml | 3 ++-
 Documentation/devicetree/bindings/vendor-prefixes.yaml      | 2 ++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/power/supply/bq25890.yaml b/Documentation/devicetree/bindings/power/supply/bq25890.yaml
index 0ad302ab2bcce..a252eba2b7f29 100644
--- a/Documentation/devicetree/bindings/power/supply/bq25890.yaml
+++ b/Documentation/devicetree/bindings/power/supply/bq25890.yaml
@@ -5,7 +5,7 @@
 $id: http://devicetree.org/schemas/power/supply/bq25890.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Bq25890, bq25892, bq25895 and bq25896 Li-Ion Charger
+title: TI BQ25890 family and SouthChip SC89890H Li-Ion Charger
 
 maintainers:
   - Sebastian Reichel <sre@kernel.org>
@@ -18,6 +18,7 @@ properties:
     oneOf:
       - enum:
           - ti,bq25890
+          - southchip,sc89890h
       - items:
           - enum:
               - ti,bq25892
diff --git a/Documentation/devicetree/bindings/vendor-prefixes.yaml b/Documentation/devicetree/bindings/vendor-prefixes.yaml
index ac83310259a91..e4583f5d3d97f 100644
--- a/Documentation/devicetree/bindings/vendor-prefixes.yaml
+++ b/Documentation/devicetree/bindings/vendor-prefixes.yaml
@@ -1563,6 +1563,8 @@ patternProperties:
     description: Sophgo Technology Inc.
   "^sourceparts,.*":
     description: Source Parts Inc.
+  "^southchip,.*":
+    description: Southchip Semiconductor Technology (Shanghai) Co., Ltd.
   "^spacemit,.*":
     description: SpacemiT (Hangzhou) Technology Co. Ltd
   "^spansion,.*":
-- 
