From 3504e27879a46c33f3dbad7ef33d77052e999ca7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Machado?= <machaddr@falanet.org>
Date: Sat, 22 Aug 2026 15:53:09 +0100
Subject: [PATCH 1/3] dt-bindings: display: cdns-dsi: add JH7110 RXESC reset
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The JH7110 DSI block has separate resets for its receive and transmit
escape paths. The vendor driver deasserts both before attempting DCS
transfers, but the binding only describes the transmit reset.

Describe the receive escape reset so the wrapper can bring the command
path fully out of reset.

Assisted-by: Codex:gpt-5
---
 .../devicetree/bindings/display/bridge/cdns,dsi.yaml | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/bridge/cdns,dsi.yaml b/Documentation/devicetree/bindings/display/bridge/cdns,dsi.yaml
index 306e470d8d7d2..69e2f22babeea 100644
--- a/Documentation/devicetree/bindings/display/bridge/cdns,dsi.yaml
+++ b/Documentation/devicetree/bindings/display/bridge/cdns,dsi.yaml
@@ -58,7 +58,8 @@ properties:
       - description: APB reset associated with dsi_p_clk
       - description: JH7110 DSI system reset
       - description: JH7110 DPI reset
-      - description: JH7110 escape-clock reset
+      - description: JH7110 receive escape-clock reset
+      - description: JH7110 transmit escape-clock reset
       - description: JH7110 TX byte high-speed reset
 
   reset-names:
@@ -67,6 +68,7 @@ properties:
       - const: dsi_p_rst
       - const: sys
       - const: dpi
+      - const: rxesc
       - const: txesc
       - const: txbytehs
 
@@ -132,11 +134,11 @@ allOf:
           minItems: 4
           maxItems: 4
         resets:
-          minItems: 5
-          maxItems: 5
+          minItems: 6
+          maxItems: 6
         reset-names:
-          minItems: 5
-          maxItems: 5
+          minItems: 6
+          maxItems: 6
       required:
         - power-domains
         - resets
