+++ b/board/pine64/pinetabv/starfive_visionfive2.c
@@ -430,9 +430,6 @@ static void get_boot_mode(void)
 #ifdef CONFIG_BOARD_LATE_INIT
 int board_late_init(void)
 {
-	struct udevice *dev;
-	int ret;
-
 	get_boot_mode();
 
 	jh7110_gmac_init(get_chip_type(), get_board_type());
@@ -443,16 +439,7 @@ int board_late_init(void)
 	 */
 	env_set_hex("memory_addr", gd->ram_base);
 	env_set_hex("memory_size", gd->ram_size);
-
-	ret = uclass_get_device(UCLASS_VIDEO, 0, &dev);
-	if (ret)
-		return ret;
-
-	ret = video_bmp_display(dev, (ulong)&bmp_logo_bitmap[0], BMP_ALIGN_CENTER, BMP_ALIGN_CENTER, true);
-	if (ret)
-		goto err;
 
-err:
 	return 0;
 }
 #endif
@@ -498,3 +498,40 @@ err:
 	return 0;
 }
 #endif
+
+#define STARFIVE_JH7110_EEPROM_DDRINFO_OFFSET	91
+
+int board_ddr_size(void)
+{
+	/* StarFive's EEPROM format stores the RAM size as one hex digit. */
+	char data[2] = { };
+	struct udevice *dev;
+	ulong size;
+	int ret;
+
+	if (!CONFIG_IS_ENABLED(ID_EEPROM))
+		return 0;
+
+	ret = uclass_get_device(UCLASS_I2C, 0, &dev);
+	if (ret) {
+		debug("I2C init failed: %d\n", ret);
+		return 0;
+	}
+
+	ret = get_data_from_eeprom(STARFIVE_JH7110_EEPROM_DDRINFO_OFFSET,
+				   1, (unsigned char *)data);
+	if (ret != 1)
+		return 0;
+
+	size = hextoul(data, NULL);
+	switch (size) {
+	case 1:
+	case 2:
+	case 4:
+	case 8:
+	case 16:
+		return size;
+	default:
+		return 0;
+	}
+}
